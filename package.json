{
  "name": "agent-smith",
  "version": "56.0.1",
  "description": "Agent Smith Reloaded v56 — updatable AppImage: the Linux AppImage now ships with a gh-releases-zsync update channel baked into its header (plus the matching .AppImage.zsync delta file), so users can get incremental in-place updates from GitHub Releases instead of re-downloading the whole ~290MB image. Carries forward v55.9.2 explicit context control (APPLY button + no 32K snap-back). v56.0.1 adds a typed custom-context field next to the Auto-tune toggle: type ANY ctx value and press APPLY to reload LM Studio at exactly that window.",
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/agent-smith",
  "main": "main.js",
  "author": {
    "name": "Agent Smith",
    "email": "YOUR_EMAIL@example.com"
  },
  "scripts": {
    "prestart": "node scripts/check-native.js && node scripts/build-renderer.js",
    "start": "electron .",
    "predist": "node scripts/check-native.js && node scripts/build-renderer.js",
    "dist": "electron-builder",
    "dist:updatable": "npm run dist && bash scripts/build-updatable-appimage.sh",
    "fix-native": "node scripts/check-native.js",
    "test": "node scripts/run-unit-tests.js",
    "harness-eval-regression": "node scripts/run-unit-tests.js tests/harness-eval/regression",
    "harness-eval-capability": "node scripts/run-unit-tests.js tests/harness-eval/capability",
    "harness-security": "node scripts/run-unit-tests.js tests/harness-security",
    "harness-eval": "node scripts/run-unit-tests.js tests/harness-eval/regression tests/harness-eval/capability",
    "ship-check": "node scripts/ship-check.js",
    "build:renderer": "node scripts/build-renderer.js",
    "watch:renderer": "node scripts/build-renderer.js --watch",
    "install-desktop": "bash scripts/install-linux-desktop.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "fast-glob": "^3.3.2",
    "highlight.js": "^11.9.0",
    "ignore": "^5.3.1",
    "marked": "^11.1.1"
  },
  "optionalDependencies": {
    "jsdom": "^24.1.3",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6"
  },
  "build": {
    "appId": "com.agentsmith.matrix",
    "productName": "Agent Smith Reloaded",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "docs/**/*",
      "examples/**/*",
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "icon.png",
      "build/icon.png",
      "build/icons/**/*",
      "AGENTS.md",
      "SMITH.md",
      "PROTOCOL.md",
      "LICENSE",
      "run.sh",
      "run.cmd"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/piper",
        "to": "piper"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "agent-smith"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@42.5.0": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true,
    "puppeteer@24.40.0": true
  }
}
