{
  "name": "agent-smith",
  "version": "54.3.0",
  "description": "Agent Smith Reloaded v54.3 — Generation timers hidden: the per-second elapsed clocks (chat pulse badge + Code Mode status bar) were multiple writers repainting the same line at once, so they jumped in and out; static '⚡ generating' / '⏳ processing prompt…' state remains.",
  "homepage": "https://github.com/dreammuse/agent-smith",
  "main": "main.js",
  "author": {
    "name": "Agent Smith",
    "email": "dreammuseltd@gmail.com"
  },
  "scripts": {
    "prestart": "node scripts/check-native.js && node scripts/build-renderer.js",
    "start": "electron .",
    "predist": "node scripts/check-native.js && node scripts/build-renderer.js",
    "dist": "electron-builder",
    "fix-native": "node scripts/check-native.js",
    "test": "node scripts/run-unit-tests.js",
    "harness-eval-regression": "node scripts/run-unit-tests.js tests/harness-eval/regression",
    "harness-eval-capability": "node scripts/run-unit-tests.js tests/harness-eval/capability",
    "harness-security": "node scripts/run-unit-tests.js tests/harness-security",
    "harness-eval": "node scripts/run-unit-tests.js tests/harness-eval/regression tests/harness-eval/capability",
    "ship-check": "node scripts/ship-check.js",
    "build:renderer": "node scripts/build-renderer.js",
    "watch:renderer": "node scripts/build-renderer.js --watch",
    "install-desktop": "bash scripts/install-linux-desktop.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "fast-glob": "^3.3.2",
    "highlight.js": "^11.9.0",
    "ignore": "^5.3.1",
    "marked": "^11.1.1"
  },
  "optionalDependencies": {
    "jsdom": "^24.1.3",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6"
  },
  "build": {
    "appId": "com.agentsmith.matrix",
    "productName": "Agent Smith Reloaded",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "docs/**/*",
      "examples/**/*",
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "icon.png",
      "build/icon.png",
      "build/icons/**/*",
      "AGENTS.md",
      "SMITH.md",
      "PROTOCOL.md",
      "LICENSE",
      "run.sh",
      "run.cmd"
    ],
    "asar": true,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "executableName": "agent-smith"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@42.5.0": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true,
    "puppeteer@24.40.0": true
  }
}
